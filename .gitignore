# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.vscode
# model.pt is committed so a fresh checkout has a trained model.
*.bak
.env

# The Pages site is built from web/ by the Deploy Pages workflow (Vite).
# web/public/{model.onnx,meta.json,config.json} are regenerated by `uv run train.py`.

# TensorBoard logs
runs/

# Node / Bun (gen_data.ts)
node_modules/

data/data.jsonl.dry

# gen_data.ts scratch (removed on a successful run; left behind for resume on crash)
data/data.jsonl.tmp

# Rebuilt from data/data.jsonl by `bun run regen`; data/data.jsonl is the committed master.
data/train.jsonl
data/eval.jsonl
data/labels.json

# regen writes these via writeFileAtomic (path.tmp then rename); a crash leaves them.
data/train.jsonl.tmp
data/eval.jsonl.tmp
data/labels.json.tmp

pt/*.pt
# SDD isolated worktrees
/.worktrees/
data/pred.jsonl
lightning_logs
# SDD scratch (ledger, briefs, review packages)
/.superpowers/
# Browser-only preview pages, regenerated on demand.
preview/
