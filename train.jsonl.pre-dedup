{"text":"Crikey, the roof's leaking upwards!","feeling":"Surprised","emoji":"🌧️","bg":["#91b9d1","#668eab"],"fg":"#102333"}
{"text":"Wait, that wall is the garden wall!","feeling":"Surprised","emoji":"🌿","bg":["#a9c18a","#7ea36f"],"fg":"#172817"}
{"text":"Good grief, the cable's in the drain!","feeling":"Surprised","emoji":"🔌","bg":["#9caeb4","#718990"],"fg":"#101b20"}
