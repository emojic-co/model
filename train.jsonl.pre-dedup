{"text":"You forgot your keys. Again.","feeling":"Angry","emoji":"🙄","bg":["#f7c3c8","#e89aa8"],"fg":"#4a1720"}
{"text":"I found your missing charger.","feeling":"Happy","emoji":"🔌","bg":["#c6ebc8","#91d3a4"],"fg":"#173d27"}
