{
  "name": "emojic-gen",
  "private": true,
  "type": "module",
  "scripts": {
    "train": "bun run tools/data/train.ts",
    "regen": "bun run tools/data/regen.ts",
    "upsample": "bun run tools/data/upsample.ts",
    "preview": "bun run tools/preview.ts",
    "preview-model": "bun run tools/data/preview-model.ts",
    "preview-labels": "bun run tools/data/preview-labels.ts",
