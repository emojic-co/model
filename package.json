{
  "name": "emojic-gen",
  "private": true,
  "type": "module",
  "scripts": {
    "train": "bun run tools/data/train.ts",
    "snapshot": "bun run tools/data/snapshot.ts",
    "re-annotate": "bun run tools/data/re-annotate.ts",
    "merge": "bun run tools/data/merge.ts",
    "split-eval": "bun run tools/data/split-eval.ts",
    "labels": "bun run tools/data/labels.ts",
    "stat": "bun run tools/data/stat.ts",
    "fails": "bun run tools/analysis/fails.ts",
    "preview": "bun run tools/data/preview.ts",
    "preview-model": "bun run tools/data/preview-model.ts",
    "preview-labels": "bun run tools/data/preview-labels.ts",
    "serve": "live-server docs --port=8000",
    "web": "cd web && bun install && bun run dev",
    "web:build": "cd web && bun install && bun run build",
    "web:test": "cd web && bun install && bun run test"
  },
  "dependencies": {
    "ai": "^7.0.83",
    "cli-progress": "^3.12.0",
    "onnxruntime-web": "^1.29.0",
    "p-queue": "^9.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/cli-progress": "^3.11.6",
    "emojibase-data": "^17.0.0",
    "live-server": "^1.2.2"
  }
}