    "p-queue": "^9.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/cli-progress": "^3.11.6",
    "emojibase-data": "^17.0.0",
    "live-server": "^1.2.2"
  }
